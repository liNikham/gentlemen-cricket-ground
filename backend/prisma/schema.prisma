datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

model User {
  id                 String   @id @default(uuid())
  mobileNumber       String   @unique
  name               String?
  email              String?
  isProfileCompleted Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Otp {
  id           String   @id @default(uuid())
  mobileNumber String
  hashedOtp    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([mobileNumber])
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  mobileNumber String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CricketGround {
  id              String   @id @default(uuid())
  name            String
  address         String
  mapLocationUrl  String?
  description     String
  images          String[] @default([])
  weekdayPrice        Float
  weekendPrice        Float
  morningPrice        Float?
  eveningPrice        Float?
  morningWeekendPrice Float?
  eveningWeekendPrice Float?
  timeSlots           String[] @default(["7:00 AM - 10:30 AM", "2:30 PM - 5:50 PM"])

  // Facilities
  hasParking      Boolean  @default(true)
  hasCharging     Boolean  @default(true)
  hasFirstAid     Boolean  @default(true)
  hasDugout       Boolean  @default(true)
  hasWashroom     Boolean  @default(true)
  hasChangingRoom Boolean  @default(true)

  // Responsible Contact Person
  contactName     String
  contactPhone    String

  // Rules & Guidelines
  rules           String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

