datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

model User {
  id                 String   @id @default(uuid())
  mobileNumber       String   @unique
  name               String?
  email              String?
  isProfileCompleted Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Otp {
  id           String   @id @default(uuid())
  mobileNumber String
  hashedOtp    String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([mobileNumber])
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  mobileNumber String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CricketGround {
  id              String   @id @default(uuid())
  name            String
  address         String
  mapLocationUrl  String?
  description     String
  images          String[] @default([])
  weekdayPrice    Float
  weekendPrice    Float
  timeSlots       String[] @default(["06:00 - 09:00", "09:00 - 12:00", "12:00 - 15:00", "15:00 - 18:00", "18:00 - 21:00", "21:00 - 00:00"])

  // Facilities
  hasParking      Boolean  @default(true)
  hasCharging     Boolean  @default(true)
  hasFirstAid     Boolean  @default(true)
  hasDugout       Boolean  @default(true)
  hasWashroom     Boolean  @default(true)
  hasChangingRoom Boolean  @default(true)

  // Responsible Contact Person
  contactName     String
  contactPhone    String

  // Rules & Guidelines
  rules           String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

